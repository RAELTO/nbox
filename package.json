{
  "name": "nbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12.3.4 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "analyze": "tsc -b && vite build --mode analyze",
    "doctor": "react-doctor . --verbose --offline --full",
    "doctor:score": "react-doctor . --score --offline --full",
    "doctor:diff": "react-doctor . --diff main --offline",
    "perf": "pnpm run build && playwright test --grep @perf --project=public-chromium",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report .tmp/playwright/report"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@supabase/supabase-js": "2.115.0",
    "@tanstack/react-query": "5.99.0",
    "emoji-picker-react": "4.20.1",
    "lucide-react": "1.8.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.72.1",
    "react-router-dom": "7.18.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.5.0",
    "prettier": "3.8.3",
    "react-doctor": "0.1.6",
    "rollup-plugin-visualizer": "7.0.1",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.2",
    "vite": "8.2.2"
  }
}
